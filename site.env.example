# Site-specific settings. Copy to site.env (git-ignored) in the deployment root and edit.
# The deployment root is this repository checkout with venv/, models/, data/ and wheels/ placed inside it.

# conda-forge gcc 13 prefix, installed offline from offline/gcc13_explicit.txt
TOOLCHAIN=/path/to/toolchains/gcc13

# CUDA 12.x toolkit used only to build the torch-harmonics extension (nvcc)
CUDA_TOOLKIT=/path/to/cuda-12.6

# Directory holding cusparse.h / cublas_v2.h. On a stock CUDA toolkit this is ${CUDA_TOOLKIT}/include;
# NVIDIA HPC SDK installs keep them in .../math_libs/<cuda version>/include instead.
CUDA_MATH_INCLUDE=${CUDA_TOOLKIT}/include

# Python 3.12 interpreter used to create venv/
BASE_PYTHON=/path/to/python3.12

# Optional: Nsight Systems CLI for jobs/corrdiff_bench_job.sh (defaults to `nsys` on PATH)
NSYS=

# Optional: an interpreter with pandas, xarray, matplotlib and cartopy (with Natural Earth 10m land cached)
# for the comparison figures. Defaults to venv/bin/python, which does not include plotting packages.
PLOT_PYTHON=
PLOT_LD_LIBRARY_PATH=
